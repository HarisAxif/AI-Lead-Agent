# Required
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_THIRD_MODEL=
GEMINI_API_KEY=your-google-ai-studio-key


# Speed (all optional, see README "Speed")
# FAST_MODE=1                       # skip screenshots: the biggest saving
# SEARCH_WORKERS=3                  # searches run at the same time (1 if search rate-limits you)
# RENDER_WORKERS=1                  # screenshots on: 3 renders three sites at once
# MAX_RUN_SECONDS=600               # stop researching after this long (0 = no limit)
# RESULT_CACHE_HOURS=168            # saved results answer repeats instantly (0 = off)
# REFRESH=1                         # ignore saved results and research again

# Optional: Google Places (needs a Google Cloud project with billing)
# GOOGLE_PLACES_API_KEY=your-places-key
# PLACES_MAX_REQUESTS_PER_RUN=15
# PLACES_DISABLED=1

MAX_RUN_SECONDS=600
ALLOW_PAID_PROVIDERS=0
# Use a Gemini API project on the free tier. The app cannot change project billing.
# Optional Places/Trustpilot credentials are ignored unless ALLOW_PAID_PROVIDERS=1.

# Optional authorized review access (requires Trustpilot Data Solutions Insights)
# TRUSTPILOT_API_KEY=your-data-solutions-key
# TRUSTPILOT_MAX_REQUESTS_PER_RUN=20
# GEMINI_MAX_WAIT_SECONDS=90

# Adaptive research (enabled by default)
# RESEARCH_MAX_STEPS_PER_COMPANY=3
# RESEARCH_MAX_SEARCHES_PER_COMPANY=5
# RESEARCH_MAX_PAGES_PER_COMPANY=8
# RESEARCH_COMPANY_SECONDS=180
# RESEARCH_PLANNER_SECONDS=20
# DISCOVERY_MAX_REPLANS=4
